{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/grade-7",
      "destination": "/grade-7/lab-measurement/",
      "permanent": false
    },
    {
      "source": "/grade-8",
      "destination": "/grade-8/stoichiometry/",
      "permanent": false
    },
    {
      "source": "/grade-11",
      "destination": "/grade-11/integration-control/",
      "permanent": false
    },
    {
      "source": "/ib-dp",
      "destination": "/ib-dp/a2-cells-viruses/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/grade-7/lab-measurement/:path*",
      "destination": "/grade-7/lab-measurement/index.html"
    },
    {
      "source": "/grade-8/stoichiometry/:path*",
      "destination": "/grade-8/stoichiometry/index.html"
    },
    {
      "source": "/grade-11/integration-control/:path*",
      "destination": "/grade-11/integration-control/index.html"
    },
    {
      "source": "/ib-dp/a2-cells-viruses/:path*",
      "destination": "/ib-dp/a2-cells-viruses/index.html"
    },
    {
      "source": "/experiments/visual-lab/:path*",
      "destination": "/experiments/visual-lab/index.html"
    }
  ]
}
