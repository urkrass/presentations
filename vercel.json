{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/grade-7",
      "destination": "/grade-7/lab-measurement/",
      "permanent": false
    },
    {
      "source": "/grade-8",
      "destination": "/grade-8/stoichiometry/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/grade-7/lab-measurement/:path*",
      "destination": "/grade-7/lab-measurement/index.html"
    },
    {
      "source": "/grade-8/stoichiometry/:path*",
      "destination": "/grade-8/stoichiometry/index.html"
    }
  ]
}
